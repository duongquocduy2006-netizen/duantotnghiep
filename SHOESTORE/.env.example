# ============================================================
# Sao chép file này thành .env và điền giá trị thực vào
# Copy this file to .env and fill in real values
# ============================================================

# DATABASE
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=SHOESTORE;encrypt=false;sendStringParametersAsUnicode=true;
DB_USERNAME=sa
DB_PASSWORD=your_db_password

# GOOGLE OAUTH2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# MAIL (Gmail SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# GHN API
GHN_API_TOKEN=your_ghn_api_token
GHN_API_SHOPID=your_ghn_shop_id

# OPENAI / ChatGPT API
OPENAI_API_KEY=your_openai_api_key

# PAYOS
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# GEMINI AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=

